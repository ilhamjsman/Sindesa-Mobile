<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools">

    <uses-permission android:name="android.permission.INTERNET" />
    <uses-permission android:name="android.permission.ACCESS_NETWORK_STATE" />
    <uses-permission android:name="android.permission.CAMERA" />
    <uses-feature android:name="android.hardware.camera" android:required="false" />
    <uses-permission android:name="android.permission.READ_EXTERNAL_STORAGE" android:maxSdkVersion="32" />
    <uses-permission android:name="android.permission.WRITE_EXTERNAL_STORAGE" android:maxSdkVersion="28" />

    <application
        android:allowBackup="false"
        android:dataExtractionRules="@xml/data_extraction_rules"
        android:fullBackupContent="@xml/backup_rules"
        android:icon="@mipmap/ic_launcher"
        android:label="@string/app_name"
        android:networkSecurityConfig="@xml/network_security_config"
        android:roundIcon="@mipmap/ic_launcher_round"
        android:supportsRtl="true"
        android:theme="@style/Theme.Sindesa">

        <!-- ============================================== -->
        <!-- LAUNCHER ACTIVITY (Aplikasi Dimulai Dari Sini) -->
        <!-- ============================================== -->
        <activity
            android:name=".WelcomeActivity"
            android:exported="true">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity>

        <!-- ============================================== -->
        <!-- ACTIVITY LAINNYA (Akses Internal)              -->
        <!-- ============================================== -->
        <activity
            android:name=".MainActivity"
            android:exported="false" />
        <activity
            android:name=".RegisterActivity"
            android:exported="false" />
        <activity
            android:name=".DashboardActivity"
            android:exported="false" />
        <activity
            android:name=".ProfileActivity"
            android:exported="false" />
        <activity
            android:name=".RiwayatActivity"
            android:exported="false" />
        <activity
            android:name=".SelesaiActivity"
            android:exported="false" />
        <activity
            android:name=".VerifikasiActivity"
            android:exported="false" />
        <activity
            android:name=".TentangKamiActivity"
            android:exported="false" />

        <!-- Kumpulan Form Layanan Surat -->
        <activity
            android:name=".AktaLahirActivity"
            android:exported="false" />
        <activity
            android:name=".BedaNamaActivity"
            android:exported="false" />
        <activity
            android:name=".BelumMenikahActivity"
            android:exported="false" />
        <activity
            android:name=".DomisiliActivity"
            android:exported="false" />
        <activity
            android:name=".IzinKeramaianActivity"
            android:exported="false" />
        <activity
            android:name=".JandaDudaActivity"
            android:exported="false" />
        <activity
            android:name=".KehilanganActivity"
            android:exported="false" />
        <activity
            android:name=".KematianActivity"
            android:exported="false" />
        <activity
            android:name=".KkActivity"
            android:exported="false" />
        <activity
            android:name=".KtpActivity"
            android:exported="false" />
        <activity
            android:name=".PenghasilanActivity"
            android:exported="false" />
        <activity
            android:name=".PindahActivity"
            android:exported="false" />
        <activity
            android:name=".SkckActivity"
            android:exported="false" />
        <activity
            android:name=".SktmActivity"
            android:exported="false" />
        <activity
            android:name=".UsahaActivity"
            android:exported="false" />
        <activity
            android:name=".PdfPreviewActivity"
            android:exported="false"
            android:configChanges="orientation|screenSize" />

        <provider
            android:name="androidx.core.content.FileProvider"
            android:authorities="${applicationId}.fileprovider"
            android:exported="false"
            android:grantUriPermissions="true">
            <meta-data
                android:name="android.support.FILE_PROVIDER_PATHS"
                android:resource="@xml/file_paths" />
        </provider>

        <receiver
            android:name="androidx.profileinstaller.ProfileInstallReceiver"
            tools:node="remove" />
    </application>

</manifest>
<?xml version="1.0" encoding="utf-8"?>
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:fillViewport="true"
    android:background="#f9f9f9"
    android:forceDarkAllowed="false"
    android:fitsSystemWindows="true"
    tools:context=".WelcomeActivity">

    <androidx.constraintlayout.widget.ConstraintLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:paddingBottom="24dp">

        <!-- Custom Toolbar (Logo SINDESA) -->
        <com.google.android.material.appbar.AppBarLayout
            android:id="@+id/appBarLayout"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:background="#FFFFFF"
            app:layout_constraintTop_toTopOf="parent"
            app:elevation="4dp">

            <androidx.appcompat.widget.Toolbar
                android:id="@+id/toolbar"
                android:layout_width="match_parent"
                android:layout_height="?attr/actionBarSize">

                <ImageView
                    android:layout_width="120dp"
                    android:layout_height="wrap_content"
                    android:adjustViewBounds="true"
                    android:contentDescription="@string/app_name"
                    android:src="@drawable/sindesa_black_transparant" />
            </androidx.appcompat.widget.Toolbar>
        </com.google.android.material.appbar.AppBarLayout>

        <!-- Hero Section Background -->
        <View
            android:id="@+id/heroBackground"
            android:layout_width="match_parent"
            android:layout_height="250dp"
            android:background="#1a5e35"
            app:layout_constraintTop_toBottomOf="@id/appBarLayout" />

        <!-- Container Teks Hero (Kanan, dengan teks rata kiri) -->
        <LinearLayout
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:gravity="start"
            android:layout_marginStart="16dp"
            android:layout_marginEnd="24dp"
            app:layout_constraintTop_toTopOf="@id/heroBackground"
            app:layout_constraintBottom_toBottomOf="@id/heroBackground"
            app:layout_constraintStart_toEndOf="@id/cvHeroImage"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintVertical_bias="0.35">

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="DIGITALISASI\nPELAYANAN DESA"
                android:textAlignment="viewStart"
                android:textColor="#FFFFFF"
                android:textSize="22sp"
                android:textStyle="bold" />

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Mewujudkan administrasi digital yang cepat dan mudah diakses."
                android:textAlignment="viewStart"
                android:textColor="#E0E0E0"
                android:textSize="13sp"
                android:layout_marginTop="8dp" />
        </LinearLayout>

        <!-- Gambar Setengah Bulat (Kiri) -->
        <com.google.android.material.card.MaterialCardView
            android:id="@+id/cvHeroImage"
            android:layout_width="160dp"
            android:layout_height="160dp"
            android:layout_marginStart="-40dp"
            app:cardCornerRadius="80dp"
            app:cardBackgroundColor="#FFFFFF"
            app:strokeWidth="6dp"
            app:strokeColor="#33FFFFFF"
            app:cardElevation="0dp"
            app:layout_constraintTop_toTopOf="@id/heroBackground"
            app:layout_constraintBottom_toBottomOf="@id/heroBackground"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintVertical_bias="0.35">

            <ImageView
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                android:scaleType="centerCrop"
                android:contentDescription="@string/desc_village_photo"
                android:src="@drawable/hero_image" />

        </com.google.android.material.card.MaterialCardView>

        <!-- Tombol Login & Register (Menumpuk di batas banner) -->
        <LinearLayout
            android:id="@+id/llButtons"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:gravity="center"
            android:layout_marginTop="-24dp"
            app:layout_constraintTop_toBottomOf="@id/heroBackground"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintEnd_toEndOf="parent">

            <!-- Tombol Login -->
            <com.google.android.material.button.MaterialButton
                android:id="@+id/btnNavLogin"
                android:layout_width="140dp"
                android:layout_height="50dp"
                android:text="Login"
                android:textColor="#2e7d32"
                android:textStyle="bold"
                app:backgroundTint="#FFFFFF"
                app:strokeColor="#2e7d32"
                app:strokeWidth="2dp"
                app:cornerRadius="25dp"
                android:layout_marginEnd="8dp"
                android:elevation="4dp"/>

            <!-- Tombol Register -->
            <com.google.android.material.button.MaterialButton
                android:id="@+id/btnNavRegister"
                android:layout_width="140dp"
                android:layout_height="50dp"
                android:text="Register"
                android:textColor="#FFFFFF"
                android:textStyle="bold"
                app:backgroundTint="#cfa03f"
                app:cornerRadius="25dp"
                android:layout_marginStart="8dp"
                android:elevation="4dp"/>
        </LinearLayout>

        <!-- Section: Layanan Desa Kami -->
        <TextView
            android:id="@+id/tvLayananTitle"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="Layanan Desa Kami"
            android:textColor="#1a5e35"
            android:textSize="22sp"
            android:textStyle="bold"
            android:textAlignment="center"
            android:layout_marginTop="32dp"
            app:layout_constraintTop_toBottomOf="@id/llButtons" />

        <TextView
            android:id="@+id/tvLayananDesc"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="Kebutuhan administrasi &amp; perizinan di Desa Buttu Sawe."
            android:textColor="#757575"
            android:textSize="14sp"
            android:textAlignment="center"
            android:layout_marginStart="32dp"
            android:layout_marginEnd="32dp"
            android:layout_marginTop="4dp"
            android:layout_marginBottom="16dp"
            app:layout_constraintTop_toBottomOf="@id/tvLayananTitle" />

        <!-- Grid Layout untuk Card Layanan -->
        <GridLayout
            android:id="@+id/gridLayanan"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:columnCount="2"
            android:rowCount="2"
            android:alignmentMode="alignMargins"
            android:columnOrderPreserved="false"
            android:padding="16dp"
            app:layout_constraintTop_toBottomOf="@id/tvLayananDesc">

            <!-- Card 1: Kependudukan -->
            <com.google.android.material.card.MaterialCardView
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_columnWeight="1"
                android:layout_margin="8dp"
                app:cardCornerRadius="12dp"
                app:cardElevation="2dp">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical"
                    android:gravity="center"
                    android:padding="16dp">
                    <ImageView
                        android:layout_width="48dp"
                        android:layout_height="48dp"
                        android:src="@android:drawable/ic_menu_myplaces"
                        app:tint="#1a5e35"
                        android:contentDescription="@string/nav_kependudukan"
                        android:layout_marginBottom="8dp"/>
                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="Administrasi\nKependudukan"
                        android:textColor="#1a5e35"
                        android:textStyle="bold"
                        android:textAlignment="center"
                        android:textSize="14sp"/>
                </LinearLayout>
            </com.google.android.material.card.MaterialCardView>

            <!-- Card 2: Perizinan -->
            <com.google.android.material.card.MaterialCardView
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_columnWeight="1"
                android:layout_margin="8dp"
                app:cardCornerRadius="12dp"
                app:cardElevation="2dp">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical"
                    android:gravity="center"
                    android:padding="16dp">
                    <ImageView
                        android:layout_width="48dp"
                        android:layout_height="48dp"
                        android:src="@android:drawable/ic_menu_agenda"
                        app:tint="#1a5e35"
                        android:contentDescription="@string/nav_perizinan"
                        android:layout_marginBottom="8dp"/>
                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="Layanan\nPerizinan Desa"
                        android:textColor="#1a5e35"
                        android:textStyle="bold"
                        android:textAlignment="center"
                        android:textSize="14sp"/>
                </LinearLayout>
            </com.google.android.material.card.MaterialCardView>

            <!-- Card 3: Surat Keterangan -->
            <com.google.android.material.card.MaterialCardView
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_columnWeight="1"
                android:layout_margin="8dp"
                app:cardCornerRadius="12dp"
                app:cardElevation="2dp">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical"
                    android:gravity="center"
                    android:padding="16dp">
                    <ImageView
                        android:layout_width="48dp"
                        android:layout_height="48dp"
                        android:src="@android:drawable/ic_menu_edit"
                        app:tint="#1a5e35"
                        android:contentDescription="@string/nav_umum"
                        android:layout_marginBottom="8dp"/>
                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="Surat Keterangan\nUmum"
                        android:textColor="#1a5e35"
                        android:textStyle="bold"
                        android:textAlignment="center"
                        android:textSize="14sp"/>
                </LinearLayout>
            </com.google.android.material.card.MaterialCardView>

            <!-- Card 4: Sosial -->
            <com.google.android.material.card.MaterialCardView
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_columnWeight="1"
                android:layout_margin="8dp"
                app:cardCornerRadius="12dp"
                app:cardElevation="2dp">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical"
                    android:gravity="center"
                    android:padding="16dp">
                    <ImageView
                        android:layout_width="48dp"
                        android:layout_height="48dp"
                        android:src="@android:drawable/ic_menu_share"
                        app:tint="#1a5e35"
                        android:contentDescription="@string/nav_sosial"
                        android:layout_marginBottom="8dp"/>
                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="Layanan\nSosial Desa"
                        android:textColor="#1a5e35"
                        android:textStyle="bold"
                        android:textAlignment="center"
                        android:textSize="14sp"/>
                </LinearLayout>
            </com.google.android.material.card.MaterialCardView>

        </GridLayout>

        <!-- Footer -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:background="#0d3320"
            android:padding="24dp"
            android:layout_marginTop="32dp"
            app:layout_constraintTop_toBottomOf="@id/gridLayanan">

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Hubungi Kami"
                android:textColor="#cfa03f"
                android:textStyle="bold"
                android:textSize="16sp"
                android:layout_marginBottom="12dp"/>

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Kantor Desa Buttu Sawe, Kec. Duampanua, Kab. Pinrang\n\nemail: layanan@desabuttusawe.id\nWA: 0812-3456-7890"
                android:textColor="#FFFFFF"
                android:textSize="12sp"
                android:layout_marginBottom="24dp"/>

            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="© 2026 SINDESA Desa Buttu Sawe. All rights reserved."
                android:textColor="#B3FFFFFF"
                android:textSize="10sp"
                android:textAlignment="center"/>
        </LinearLayout>

    </androidx.constraintlayout.widget.ConstraintLayout>
</ScrollView>
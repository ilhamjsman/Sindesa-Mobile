<resources xmlns:tools="http://schemas.android.com/tools">
    <!-- Base application theme. -->
    <style name="Base.Theme.Sindesa" parent="Theme.Material3.Light.NoActionBar">
        <!-- Warna Utama Aplikasi (Menggantikan warna ungu default) -->
        <item name="colorPrimary">@color/primary_green</item>
        <item name="colorOnPrimary">@color/white</item>

        <!-- Warna untuk Outline/Garis Tepi Kolom saat tidak fokus -->
        <item name="colorOutline">@color/primary_green</item>

        <!-- Warna sekunder (Emas) -->
        <item name="colorSecondary">@color/primary_gold</item>

        <!-- Memaksa background tetap putih dan matikan force dark -->
        <item name="android:windowBackground">@color/white</item>
        <item name="android:forceDarkAllowed" tools:targetApi="q">false</item>
    </style>

    <style name="Theme.Sindesa" parent="Base.Theme.Sindesa" />

    <style name="CircleImage">
        <item name="cornerSize">50%</item>
    </style>

    <style name="SidebarSubMenu">
        <item name="android:layout_width">match_parent</item>
        <item name="android:layout_height">wrap_content</item>
        <item name="android:paddingVertical">8dp</item>
        <item name="android:textColor">#B3B3B3</item>
        <item name="android:textSize">13sp</item>
        <item name="android:clickable">true</item>
        <item name="android:focusable">true</item>
        <item name="android:foreground">?attr/selectableItemBackground</item>
    </style>
</resources>